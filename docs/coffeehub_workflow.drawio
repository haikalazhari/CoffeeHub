<mxfile host="app.diagrams.net" pages="3">
  <!-- TAB 1: WORKFLOW OPERASIONAL PEMESANAN & KASIR -->
  <diagram name="1. Workflow Pemesanan &amp; Kasir" id="wf_order_cashier">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250" background="#FFFFFF" math="0" shadow="0">
