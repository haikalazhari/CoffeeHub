        <!-- Title Banner -->
        <mxCell id="hdr_tab1" value="&lt;b&gt;WORKFLOW OPERASIONAL PEMESANAN &amp;amp; KASIR COFFEEHUB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Alur Kerja End-to-End: Pemilihan Menu &amp;rarr; Validasi Sistem &amp;rarr; Peracikan Barista &amp;rarr; Pembayaran Kasir &amp;rarr; Penyerahan Produk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C1A11;strokeColor=#1A0F0A;fontColor=#FFFFFF;fontSize=13;fontFamily=Segoe UI, Arial;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="45" as="geometry" />
        </mxCell>

