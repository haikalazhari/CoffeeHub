        <mxCell id="odt_row_3" value="&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;b&gt;product_id&lt;/b&gt; : INT &lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;*&lt;/b&gt;&lt;/font&gt;" style="text;strokeColor=#EFEBE9;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI, Arial;" vertex="1" parent="table_order_details">
          <mxGeometry y="96" width="360" height="32" as="geometry" />
