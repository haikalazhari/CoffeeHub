        <mxCell id="odt_row_4" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;quantity&lt;/b&gt; : INT &lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;*&lt;/b&gt;&lt;/font&gt;" style="text;strokeColor=#EFEBE9;fillColor=#FDFCFA;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI, Arial;" vertex="1" parent="table_order_details">
