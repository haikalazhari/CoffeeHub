        <!-- ================= CARD: LEGEND / KETERANGAN ================= -->
        <mxCell id="legend_box" value="&lt;b&gt;KETERANGAN &amp;amp; NOTASI&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#5D4037;fontColor=#FFFFFF;strokeColor=#4E342E;strokeWidth=1;fontSize=12;fontFamily=Segoe UI;shadow=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="325" width="330" height="450" as="geometry" />
        </mxCell>
        <mxCell id="legend_content" value="&lt;div style=&quot;padding: 4px; line-height: 1.5; font-family: Segoe UI, sans-serif;&quot;&gt;
&lt;b style=&quot;color: #3E2723;&quot;&gt;SIMBOL KOLOM:&lt;/b&gt;&lt;br&gt;
&amp;bull; &lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; : Primary Key (Kunci Utama)&lt;br&gt;
&amp;bull; &lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; : Foreign Key (Kunci Tamu)&lt;br&gt;
&amp;bull; &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;[UQ]&lt;/b&gt;&lt;/font&gt; : Unique Constraint (Nilai Unik)&lt;br&gt;
&amp;bull; &lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;*&lt;/b&gt;&lt;/font&gt; : Kolom NOT NULL (Wajib diisi)&lt;br&gt;
&lt;hr style=&quot;border: 0; border-top: 1px solid #D7CCC8; margin: 8px 0;&quot;&gt;
&lt;b style=&quot;color: #3E2723;&quot;&gt;KARDINALITAS RELASI:&lt;/b&gt;&lt;br&gt;
&amp;bull; &lt;b&gt;1 : 0..N&lt;/b&gt; (One to Zero-or-Many)&lt;br&gt;
&amp;bull; &lt;b&gt;1 : 1..N&lt;/b&gt; (One to One-or-Many)&lt;br&gt;
&amp;bull; Notasi Crow's Foot:&lt;br&gt;
&amp;nbsp;&amp;nbsp;&amp;bull; &lt;b&gt;||&lt;/b&gt; : Mandatory One (Pasti 1)&lt;br&gt;
&amp;nbsp;&amp;nbsp;&amp;bull; &lt;b&gt;o&amp;lt;&lt;/b&gt; : Optional Many (0..*)&lt;br&gt;
&amp;nbsp;&amp;nbsp;&amp;bull; &lt;b&gt;|&amp;lt;&lt;/b&gt; : Mandatory Many (1..*)&lt;br&gt;
&lt;hr style=&quot;border: 0; border-top: 1px solid #D7CCC8; margin: 8px 0;&quot;&gt;
&lt;b style=&quot;color: #3E2723;&quot;&gt;ATURAN REFERENSIAL (FK):&lt;/b&gt;&lt;br&gt;
&amp;bull; &lt;b&gt;CASCADE&lt;/b&gt;: Induk berubah/dihapus, anak otomatis ikut diperbarui/dihapus.&lt;br&gt;
&amp;bull; &lt;b&gt;RESTRICT&lt;/b&gt;: Induk dilarang dihapus jika masih direferensikan anak.&lt;br&gt;
&amp;bull; &lt;b&gt;SET NULL&lt;/b&gt;: Jika induk dihapus, nilai FK anak diset ke NULL.
&lt;/div&gt;" style="text;strokeColor=#EFEBE9;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="legend_box">
          <mxGeometry y="28" width="330" height="422" as="geometry" />
        </mxCell>

        <!-- ================= CARD: FOOTER INFO ================= -->
        <mxCell id="footer_info" value="&lt;b&gt;CoffeeHub Desktop App&lt;/b&gt; &amp;bull; JavaFX 21 + MariaDB JDBC Driver &amp;bull; Arsitektur: MVC (Model-View-Controller) + DAO Pattern &amp;bull; Dibuat untuk Proyek Akhir Praktikum PBO 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#D7CCC8;fontColor=#4E342E;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="825" width="1310" height="40" as="geometry" />
        </mxCell>

        <!-- ================= RELATIONSHIPS / CONNECTORS ================= -->

        <!-- 1. categories.id -> products.category_id (Left to Right) -->
        <mxCell id="rel_cat_prod" value="&lt;b&gt;fk_products_categories&lt;/b&gt;&lt;br&gt;1 : 0..N&lt;br&gt;&lt;font color=&quot;#5D4037&quot; style=&quot;font-size:9px;&quot;&gt;ON UPDATE CASCADE&lt;br&gt;ON DELETE SET NULL&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#4E342E;strokeWidth=2;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Segoe UI;fontSize=10;fontColor=#3E2723;labelBackgroundColor=#FFFFFF;labelBorderColor=#D7CCC8;" edge="1" parent="1" source="cat_row_1" target="prod_row_2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="208" />
              <mxPoint x="460" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 2. users.id -> orders.user_id (Top to Bottom) -->
        <mxCell id="rel_usr_ord" value="&lt;b&gt;fk_orders_users&lt;/b&gt;&lt;br&gt;1 : 0..N&lt;br&gt;&lt;font color=&quot;#5D4037&quot; style=&quot;font-size:9px;&quot;&gt;ON UPDATE CASCADE&lt;br&gt;ON DELETE RESTRICT&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4E342E;strokeWidth=2;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Segoe UI;fontSize=10;fontColor=#3E2723;labelBackgroundColor=#FFFFFF;labelBorderColor=#D7CCC8;" edge="1" parent="1" source="table_users" target="table_orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. products.id -> order_details.product_id (Top to Bottom) -->
        <mxCell id="rel_prod_odt" value="&lt;b&gt;fk_order_details_products&lt;/b&gt;&lt;br&gt;1 : 0..N&lt;br&gt;&lt;font color=&quot;#5D4037&quot; style=&quot;font-size:9px;&quot;&gt;ON UPDATE CASCADE&lt;br&gt;ON DELETE RESTRICT&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4E342E;strokeWidth=2;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontFamily=Segoe UI;fontSize=10;fontColor=#3E2723;labelBackgroundColor=#FFFFFF;labelBorderColor=#D7CCC8;" edge="1" parent="1" source="table_products" target="table_order_details">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. orders.id -> order_details.order_id (Right to Left) -->
        <mxCell id="rel_ord_odt" value="&lt;b&gt;fk_order_details_orders&lt;/b&gt;&lt;br&gt;1 : 1..N&lt;br&gt;&lt;font color=&quot;#5D4037&quot; style=&quot;font-size:9px;&quot;&gt;ON UPDATE CASCADE&lt;br&gt;ON DELETE CASCADE&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#4E342E;strokeWidth=2;startArrow=ERmandOne;startFill=0;endArrow=ERoneToMany;endFill=0;fontFamily=Segoe UI;fontSize=10;fontColor=#3E2723;labelBackgroundColor=#FFFFFF;labelBorderColor=#D7CCC8;" edge="1" parent="1" source="ord_row_1" target="odt_row_2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="558" />
              <mxPoint x="940" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
