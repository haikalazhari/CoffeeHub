<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.voidsyntax.coffeehub.controller.CustomerCartController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #F7F1E8; -fx-background-color: #F7F1E8; -fx-border-color: transparent; -fx-padding: 0;">

    <VBox spacing="20" style="-fx-background-color: #F7F1E8;">
        <padding>
            <Insets top="30" right="35" bottom="30" left="35"/>
        </padding>

        <VBox spacing="5">
            <Label text="Shopping Cart"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #493629;"/>

            <Label text="Review and manage your selected products."
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #8B7562;"/>
        </VBox>

        <HBox spacing="20" alignment="TOP_LEFT">

            <VBox spacing="15"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 25;">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Cart Items"
                           style="-fx-font-size: 19px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #493629;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="selectAllCheckBox"
                              text="Pilih Semua"
                              selected="true"
                              onAction="#handleSelectAll"
                              style="-fx-font-size: 13px; -fx-text-fill: #56301F; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <VBox fx:id="cartItemsContainer"
                      spacing="15"/>

            </VBox>

            <VBox spacing="15"
                  prefWidth="290"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 22;">

                <Label text="Order Summary"
                       style="-fx-font-size: 19px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #493629;"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Items"
                           style="-fx-text-fill: #8B7562;"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label fx:id="itemCountLabel"
                           text="0 item"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #493629;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Price"
                           style="-fx-text-fill: #8B7562;"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label fx:id="totalLabel"
                           text="Rp0"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #795548;"/>
                </HBox>

                <Region prefHeight="1" style="-fx-background-color: #E8D8C8;"/>

                <Label text="Metode Pembayaran"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #493629;"/>

                <VBox spacing="8">
                    <RadioButton fx:id="tunaiRadio" text="💵 Tunai (Cash di Kasir)" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="paymentToggleGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="qrisRadio" text="📱 QRIS" toggleGroup="$paymentToggleGroup"/>
                    <RadioButton fx:id="bcaRadio" text="💳 Transfer Bank BCA" toggleGroup="$paymentToggleGroup"/>
                </VBox>

                <VBox fx:id="paymentInfoBox" spacing="5"
                      style="-fx-background-color: #FAF4ED;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #E8D8C8;
                             -fx-border-radius: 8;">
                    <Label fx:id="paymentTitleLabel" text="Pembayaran Tunai"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>
                    <Label fx:id="paymentDetailLabel" wrapText="true"
                           text="Bayar langsung di meja kasir saat mengambil pesanan."
                           style="-fx-font-size: 11px; -fx-text-fill: #8B7562;"/>
                </VBox>

                <Region prefHeight="1" style="-fx-background-color: #E8D8C8;"/>

                <VBox spacing="6">
                    <Label text="Catatan Pesanan (Notes)"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #493629;"/>
                    <TextArea fx:id="orderNotesField"
                              promptText="Tulis catatan (misal: less sugar, es sedikit, tanpa sedotan)..."
                              prefRowCount="2"
                              wrapText="true"
                              style="-fx-font-size: 12px;
                                     -fx-border-color: #E8D8C8;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;"/>
                </VBox>

                <Button text="Proceed to Checkout"
                        onAction="#handleCheckout"
                        maxWidth="Infinity"
                        style="-fx-background-color: #795548;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 12;
                               -fx-cursor: hand;"/>

            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
