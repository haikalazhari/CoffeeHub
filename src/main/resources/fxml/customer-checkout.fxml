<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.voidsyntax.coffeehub.controller.CustomerCheckoutController"
      spacing="22"
      style="-fx-background-color: #F7F1E8;">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <VBox spacing="5">
        <Label text="Checkout"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #493629;"/>

        <Label text="Review your order before confirming."
               style="-fx-font-size: 14px;
                      -fx-text-fill: #8B7562;"/>
    </VBox>

    <VBox spacing="18"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Order Details"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #493629;"/>

        <VBox fx:id="checkoutItemsContainer"
              spacing="12"/>

        <HBox alignment="CENTER_LEFT">
            <Label text="Total Items"
                   style="-fx-text-fill: #8B7562;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="totalItemsLabel"
                   text="0 item"
                   style="-fx-font-weight: bold;
                          -fx-text-fill: #493629;"/>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Total Payment"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #493629;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="totalPriceLabel"
                   text="Rp0"
                   style="-fx-font-size: 19px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #795548;"/>
        </HBox>

    </VBox>

    <VBox spacing="12"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Payment Method"
               style="-fx-font-size: 19px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #493629;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Cash (Tunai)"
                   style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #795548;"/>

            <Label text="Available"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #6D8B55;
                          -fx-background-color: #EDF4E7;
                          -fx-background-radius: 5;
                          -fx-padding: 5 10;"/>
        </HBox>

        <Label text="Payment will be made directly at the cashier."
               wrapText="true"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #8B7562;"/>

    </VBox>

    <Button text="Place Order"
            onAction="#handlePlaceOrder"
            maxWidth="Infinity"
            style="-fx-background-color: #795548;
                   -fx-text-fill: white;
                   -fx-font-size: 15px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 14;
                   -fx-cursor: hand;"/>

</VBox>
