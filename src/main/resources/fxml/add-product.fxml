<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.voidsyntax.coffeehub.controller.AddProductController"
      spacing="15"
      prefWidth="480"
      style="-fx-background-color: #F5EFE6;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Add New Product"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5C3825;"/>

    <VBox spacing="5">
        <Label text="Product Name"/>
        <TextField fx:id="nameField"
                   promptText="Enter product name"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Description"/>
        <TextArea fx:id="descriptionField"
                  promptText="Enter product description"
                  prefRowCount="3"
                  wrapText="true"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Category"/>
        <ComboBox fx:id="categoryComboBox"
                  promptText="Select category"
                  maxWidth="Infinity"/>
    </VBox>

    <GridPane hgap="15" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0">
            <Label text="Price (Rp)"/>
            <TextField fx:id="priceField"
                       promptText="Example: 25000"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1">
            <Label text="Stock"/>
            <TextField fx:id="stockField"
                       promptText="Example: 50"/>
        </VBox>
    </GridPane>

    <VBox spacing="5">
        <Label text="Image Path"/>
        <TextField fx:id="imageField"
                   promptText="Enter image file path (optional)"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Availability"/>
        <CheckBox fx:id="availabilityCheckBox"
                  text="Product is available"
                  selected="true"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: #D8C7B8; -fx-text-fill: #5C3825; -fx-background-radius: 7; -fx-padding: 9 20;"/>

        <Button text="Save Product"
                onAction="#handleSave"
                style="-fx-background-color: #8B6048; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 20;"/>
    </HBox>

</VBox>
