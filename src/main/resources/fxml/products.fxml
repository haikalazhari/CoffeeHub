<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.voidsyntax.coffeehub.controller.ProductsController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #F7F1E8;">

    <top>
        <VBox spacing="8" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="30" right="35" bottom="20" left="35"/>
            </padding>

            <Label text="Products"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>

            <Label text="Manage your coffee shop products"
                   style="-fx-font-size: 14px; -fx-text-fill: #8B7562;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="10" right="35" bottom="30" left="35"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="Product List"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Add Product"
                        onAction="#handleAddProduct"
                        style="-fx-background-color: #70452F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="productTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" minWidth="45" maxWidth="60"/>
                    <TableColumn fx:id="nameColumn" text="Product Name" minWidth="160"/>
                    <TableColumn fx:id="categoryColumn" text="Category" minWidth="130"/>
                    <TableColumn fx:id="priceColumn" text="Price" minWidth="110"/>
                    <TableColumn fx:id="stockColumn" text="Stock" minWidth="75" maxWidth="90"/>
                    <TableColumn fx:id="availabilityColumn" text="Availability" minWidth="120"/>
                    <TableColumn fx:id="actionColumn" text="Action" minWidth="140" maxWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
