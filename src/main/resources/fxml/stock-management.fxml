<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.voidsyntax.coffeehub.controller.StockController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #F7F1E8;">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="30" right="35" bottom="20" left="35"/>
            </padding>

            <Label text="Stock Management"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>

            <Label text="Monitor and manage your product inventory"
                   style="-fx-font-size: 14px; -fx-text-fill: #8B7562;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="10" right="35" bottom="30" left="35"/>
            </padding>

            <GridPane hgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <VBox spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E8D8C8; -fx-border-radius: 12;"
                      GridPane.columnIndex="0">

                    <Label text="Total Products"
                           style="-fx-text-fill: #8B7562; -fx-font-size: 13px;"/>

                    <Label fx:id="totalProductsLabel"
                           text="0"
                           style="-fx-text-fill: #56301F; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E8D8C8; -fx-border-radius: 12;"
                      GridPane.columnIndex="1">

                    <Label text="Low Stock"
                           style="-fx-text-fill: #8B7562; -fx-font-size: 13px;"/>

                    <Label fx:id="lowStockLabel"
                           text="0"
                           style="-fx-text-fill: #C28A35; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E8D8C8; -fx-border-radius: 12;"
                      GridPane.columnIndex="2">

                    <Label text="Out of Stock"
                           style="-fx-text-fill: #8B7562; -fx-font-size: 13px;"/>

                    <Label fx:id="outOfStockLabel"
                           text="0"
                           style="-fx-text-fill: #A65345; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                </VBox>
            </GridPane>

            <Label text="Inventory List"
                   style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>

            <TableView fx:id="stockTable"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 minWidth="45" maxWidth="60"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Product Name"
                                 minWidth="160"/>

                    <TableColumn fx:id="categoryColumn"
                                 text="Category"
                                 minWidth="130"/>

                    <TableColumn fx:id="stockColumn"
                                 text="Current Stock"
                                 minWidth="100" maxWidth="120"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Stock Status"
                                 minWidth="130"/>

                    <TableColumn fx:id="actionColumn"
                                 text="Action"
                                 minWidth="110" maxWidth="130"/>
                </columns>

            </TableView>
        </VBox>
    </center>

</BorderPane>
