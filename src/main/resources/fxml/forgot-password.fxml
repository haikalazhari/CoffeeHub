<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.voidsyntax.coffeehub.controller.ForgotPasswordController"
      alignment="CENTER" spacing="12" style="-fx-background-color: #F7F1E8;"
      prefWidth="900" prefHeight="650">
    <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

    <VBox alignment="CENTER" spacing="4">
        <ImageView fitWidth="70" fitHeight="70" preserveRatio="true">
            <image><Image url="@../images/coffeehub-logo.png"/></image>
        </ImageView>
        <Label text="CoffeeHub" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <Label text="Reset Your Password" style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <Label text="Enter your registered email and set a new password" style="-fx-font-size: 13px; -fx-text-fill: #987A64;"/>
    </VBox>

    <Region prefHeight="4"/>

    <VBox spacing="8" maxWidth="380" style="-fx-background-color: white; -fx-background-radius: 16;">
        <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>

        <Label text="Registered Email" style="-fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <TextField fx:id="emailField" promptText="Enter your registered email" prefHeight="40"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC;"/>

        <Label text="New Password" style="-fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="newPasswordField" promptText="Minimum 8 characters" prefHeight="40"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <TextField fx:id="newPasswordTextField" promptText="Minimum 8 characters" prefHeight="40" visible="false" managed="false"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <Button fx:id="toggleNewPasswordButton" text="👁" onAction="#handleToggleNewPassword"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-text-fill: #8B7562; -fx-padding: 0 12 0 0;"/>
        </StackPane>

        <Label text="Confirm New Password" style="-fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your new password" prefHeight="40"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <TextField fx:id="confirmPasswordTextField" promptText="Re-enter your new password" prefHeight="40" visible="false" managed="false"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <Button fx:id="toggleConfirmPasswordButton" text="👁" onAction="#handleToggleConfirmPassword"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-text-fill: #8B7562; -fx-padding: 0 12 0 0;"/>
        </StackPane>

        <Region prefHeight="4"/>

        <Button text="Reset Password" onAction="#handleResetPassword" maxWidth="Infinity" prefHeight="44"
                style="-fx-background-color: #70452F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 9; -fx-cursor: hand;"/>

        <Label fx:id="messageLabel" text="" wrapText="true" style="-fx-text-fill: #B33A3A;"/>
    </VBox>

    <HBox alignment="CENTER" spacing="5">
        <Label text="Remember your password?" style="-fx-text-fill: #987A64;"/>
        <Button text="Back to Login" onAction="#handleBackToLogin"
                style="-fx-background-color: transparent; -fx-text-fill: #70452F; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>
