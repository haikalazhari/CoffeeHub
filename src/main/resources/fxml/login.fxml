<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.voidsyntax.coffeehub.controller.LoginController"
      alignment="CENTER" spacing="17" style="-fx-background-color: #F7F1E8;"
      prefWidth="900" prefHeight="600">
    <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>

    <VBox alignment="CENTER" spacing="5">
        <ImageView fitWidth="82" fitHeight="82" preserveRatio="true">
            <image><Image url="@../images/coffeehub-logo.png"/></image>
        </ImageView>
        <Label text="CoffeeHub" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <Label text="Welcome Back!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <Label text="Sign in to continue to CoffeeHub" style="-fx-font-size: 13px; -fx-text-fill: #987A64;"/>
    </VBox>

    <Region prefHeight="3"/>
    <VBox spacing="9" maxWidth="370" style="-fx-background-color: white; -fx-background-radius: 16;">
        <padding><Insets top="24" right="26" bottom="24" left="26"/></padding>
        <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #56301F;"/>
        <TextField fx:id="emailField" promptText="Enter your email" prefHeight="43"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC;"/>
        <HBox alignment="CENTER_LEFT">
            <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #56301F;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Forgot Password?" onAction="#handleForgotPassword"
                    style="-fx-background-color: transparent; -fx-text-fill: #8A5A3D; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="passwordField" promptText="Enter your password" prefHeight="43"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <TextField fx:id="passwordTextField" promptText="Enter your password" prefHeight="43" visible="false" managed="false"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2D3C5; -fx-background-color: #FFFEFC; -fx-padding: 0 42 0 12;"/>
            <Button fx:id="togglePasswordButton" text="👁" onAction="#handleTogglePassword"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-text-fill: #8B7562; -fx-padding: 0 12 0 0;"/>
        </StackPane>
        <Region prefHeight="4"/>
        <Button text="Sign In" onAction="#handleLogin" maxWidth="Infinity" prefHeight="46"
                style="-fx-background-color: #70452F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 9; -fx-cursor: hand;"/>
        <Label fx:id="messageLabel" text="" wrapText="true" style="-fx-text-fill: #B33A3A;"/>
    </VBox>
    <HBox alignment="CENTER" spacing="5">
        <Label text="Don't have an account?" style="-fx-text-fill: #987A64;"/>
        <Button text="Register" onAction="#handleRegister"
                style="-fx-background-color: transparent; -fx-text-fill: #70452F; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>
